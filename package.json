{
  "name": "@dsh-community/dsh-ssh-workspace",
  "version": "0.1.24",
  "description": "Remote SSH workspaces for DSH: mount a directory on an SSH host as a DSH workspace with browser UI sidebar panel",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siqyka/dsh-ssh-workspace.git"
  },
  "homepage": "https://github.com/siqyka/dsh-ssh-workspace#readme",
  "bugs": {
    "url": "https://github.com/siqyka/dsh-ssh-workspace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./protocol": {
      "default": "./lib/protocol.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "ssh",
    "workspace",
    "remote"
  ],
  "author": "siqyka"
}
