{
  "name": "@shiqyka/dsh-ssh-workspace",
  "version": "0.3.6",
  "description": "Remote SSH workspaces for DSH: mount a directory on an SSH host as a DSH workspace with browser UI sidebar panel",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siqyka/dsh-ssh-workspace.git"
  },
  "homepage": "https://github.com/siqyka/dsh-ssh-workspace#readme",
  "bugs": {
    "url": "https://github.com/siqyka/dsh-ssh-workspace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/run.mjs",
    "lint": "node scripts/lint.mjs",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/doc-numbers.mjs --check",
    "check:client-map": "node scripts/client-map.mjs",
    "check": "npm run lint && npm run check:editor && npm run check:docs && npm run check:client-map && npm test && npm pack --dry-run",
    "doc-numbers": "node scripts/doc-numbers.mjs",
    "build:editor": "node scripts/build-editor-engine.mjs",
    "check:editor": "node scripts/build-editor-engine.mjs --check"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./protocol": {
      "default": "./lib/core/protocol.js"
    },
    "./client": {
      "default": "./lib/client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "ssh",
    "workspace",
    "remote"
  ],
  "author": "siqyka",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "esbuild": "^0.28.2"
  }
}
